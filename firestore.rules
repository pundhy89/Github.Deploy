rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUserTokens(data) {
      return data.keys().hasOnly(['userId', 'githubToken', 'vercelToken', 'updatedAt'])
        && data.userId == request.auth.uid
        && (data.get('githubToken', '') is string)
        && (data.get('vercelToken', '') is string)
        && data.updatedAt == request.time.toMillis();
    }
    
    match /users/{userId}/secrets/tokens {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
                    && isValidUserTokens(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId
                    && isValidUserTokens(incoming())
                    && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
